  "spec": "sources-and-permissions §1-3, 6",
  "files": {
   "main.md": "---\nvariables:\n  price:\n    type: number\n    unit: USD\n    source:\n      kind: http\n      format: json\n      url: https://example.invalid/stocks/AAPL\n      select: /price\n---\nPrice is {{price}}\n"
  },
