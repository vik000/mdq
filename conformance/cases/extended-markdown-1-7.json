[
 {
  "id": "a-core-plain-md-unchanged",
  "rules": [
   "CORE-PLAIN-MD-VALID",
   "CORE-COMMONMARK-SEMANTICS"
  ],
  "spec": "extended-markdown §1",
  "files": {
   "main.md": "# Title\n\nSome *text*, `code` and [a link](x.md \"t\").\n\n> quote\n\n- a\n- b\n\n1. one\n\n    indented\n\n***\n\n<div>raw</div>\n"
  },
  "entry": "main.md",
  "expect": {
   "output": "# Title\n\nSome *text*, `code` and [a link](x.md \"t\").\n\n> quote\n\n- a\n- b\n\n1. one\n\n    indented\n\n***\n\n<div>raw</div>\n"
  }
 },
 {
  "id": "a-core-gfm-constructs-kept",
  "rules": [
   "CORE-COMMONMARK-SEMANTICS"
  ],
  "spec": "extended-markdown §1, §7",
  "files": {
   "main.md": "| a | b |\n| - | - |\n| 1 | 2 |\n\n- [x] done\n- [ ] todo\n\n~~gone~~ https://example.com\n"
  },
  "entry": "main.md",
  "expect": {
   "output": "| a | b |\n| - | - |\n| 1 | 2 |\n\n- [x] done\n- [ ] todo\n\n~~gone~~ https://example.com\n"
  }
 },
 {
  "id": "a-core-build-strips-block-ids",
  "rules": [
   "CORE-BUILD-NO-UNRESOLVED-DIRECTIVES"
  ],
  "spec": "extended-markdown §1, §3",
  "files": {
   "main.md": "# Title ^top\n\nPara ^p1\n"
  },
  "entry": "main.md",
  "expect": {
   "output": "# <a id=\"top\"></a>Title\n\n<a id=\"p1\"></a>Para\n"
  }
 },
 {
  "id": "a-core-build-wiki-link-not-left-literal",
  "rules": [
   "CORE-BUILD-NO-UNRESOLVED-DIRECTIVES",
   "COMP-REF-LINK-REWRITE"
  ],
  "spec": "extended-markdown §1, §3",
  "files": {
   "main.md": "![[b.md]]\n\nSee [[b.md#X|the X]].\n",
   "b.md": "# X\n"
  },
  "entry": "main.md",
  "expect": {
   "output": "# X\n\nSee [the X](#x).\n"
  }
 },
 {
